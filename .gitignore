# ================================================================
# Scout-AI — .gitignore
# ================================================================

# ── SECRETS & ENVIRONMENT ─────────────────────────────────────
.env
.env.*
!.env.example

# ── PYTHON ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
*.dist-info/

# ── VIRTUAL ENVIRONMENTS ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── TESTING & LINTING ─────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── IDE / EDITOR ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── LOGS & TEMP ───────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp

# ── JUPYTER NOTEBOOKS ─────────────────────────────────────────
.ipynb_checkpoints/

# ── LARGE PRESENTATION FILES ──────────────────────────────────
# These exceed GitHub size limits — store in docs/presentations/ locally
*.pdf
*.pptx
*.ppt
*.key

# ── ML MODELS (large binary files) ────────────────────────────
# Models are regenerated by running pipeline_ia.py
# Uncomment the next lines if you want to exclude them:
# models/*.joblib
# models/*.pkl
# models/*.h5
# models/*.pt

# ── DOCKER VOLUMES & DATA ─────────────────────────────────────
# Named volumes are managed by Docker, not tracked
docker-volumes/

# ── GENERATED DATA (optional — data/ files can be large) ──────
# The data/ directory contains generated outputs.
# Uncomment these if you don't want to track collected data:
# data/axe3_web_logs.csv
# data/axe1_articles_bruts.json
# data/axe1_articles_enrichis.json

# ── ELASTICSEARCH DATA DIR ────────────────────────────────────
elasticsearch/

# ── OTHER ──────────────────────────────────────────────────────
*.bak
*.orig

# ================================================================
# Scout-AI — Environment Variables Template
# ================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is already in .gitignore.
# NEVER share real API keys in this file.
#
# ⚠️  SECURITY NOTICE:
# If you previously used Scout-AI with hardcoded API keys, those keys
# are now considered compromised. Rotate them immediately:
#   - Football-Data API: https://www.football-data.org/client/register
#   - NewsAPI:           https://newsapi.org/account
# ================================================================


# ── EXTERNAL APIs ──────────────────────────────────────────────

# Football-Data.org API key (free tier: 10 req/min)
# Register: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# NewsAPI key (free tier: 100 req/day)
# Register: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here


# ── NOSQL DATABASES ────────────────────────────────────────────

# MongoDB connection URI
# Default: unauthenticated local instance (development only)
# Production: mongodb://username:password@host:27017/dbname
MONGO_URI=mongodb://localhost:27017

# Neo4J connection settings
# Default URI for local Docker container (see docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Leave blank if running with NEO4J_AUTH=none (default Docker config)
NEO4J_PASSWORD=

# ElasticSearch host URL
# Note: Ensure Python elasticsearch client version matches Docker image version.
# Docker image: elasticsearch:8.12.0
# Python client: pip install elasticsearch>=8.0.0
ELASTIC_HOST=http://localhost:9200
